[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    migrations/versions,
    .pytest_cache,
    .mypy_cache
per-file-ignores =
    src/database/__init__.py:F401
    src/database/models/__init__.py:F401
    src/migrations/env.py:F401
    src/database/migrations/versions/*.py:F401
    src\routes\__init__.py:F401
